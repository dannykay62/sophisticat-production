# ============================================================================
# Sophisticat Production Environment
# ============================================================================
# Copy this file to: backend/.env
#
# This file is loaded automatically by docker-compose.prod.yml via `env_file`.
#
# IMPORTANT:
# - Never commit this file to Git.
# - Every value below should contain your REAL production credentials.
# - Store a secure backup of this file.
# ============================================================================


# ============================================================================
# Django
# ============================================================================

# Generate a new secret key with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=aSTVgiKrDFwUMB-6kXKRpAxc8dDqrPt8WjoJzgwrcr-d45K0WDPTw7PdqVJvwjGkz3Y

# Never enable DEBUG in production.
DJANGO_DEBUG=False

# Comma-separated hostnames only.
# Do NOT include http:// or https://.
DJANGO_ALLOWED_HOSTS=shopsophisticat.com,www.shopsophisticat.com,backend


# ============================================================================
# Database
# ============================================================================
# These values must exactly match the PostgreSQL credentials defined in the
# root production .env file used by Docker Compose.

DB_NAME=sophisticat
DB_USER=sophisticat_user
DB_PASSWORD=


# ============================================================================
# Media Storage
# ============================================================================
# Sophisticat stores uploaded media locally on the DigitalOcean Droplet.
#
# Uploaded files are written to Django's MEDIA_ROOT (/app/media), which is
# mounted to the persistent backend_media Docker volume and served by Nginx.
#
# Ensure the backend_media Docker volume is included in your server backups,
# otherwise product images and uploaded files will be lost if the server fails.
#
# Leave the Cloudinary settings blank unless you migrate to Cloudinary later.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ============================================================================
# Frontend / CORS / CSRF
# ============================================================================
# The frontend and API are both served through Nginx on the same domain.

FRONTEND_URL=https://shopsophisticat.com

CORS_ALLOWED_ORIGINS=https://shopsophisticat.com,https://www.shopsophisticat.com

CSRF_TRUSTED_ORIGINS=https://shopsophisticat.com,https://www.shopsophisticat.com


# ============================================================================
# Email (Zoho Mail)
# ============================================================================
# Used for:
# - Order confirmations
# - Password resets
# - Contact form notifications
# - Future customer emails

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

EMAIL_HOST_USER=hello@shopsophisticat.com
EMAIL_HOST_PASSWORD=

DEFAULT_FROM_EMAIL=Sophisticat <hello@shopsophisticat.com>


# ============================================================================
# Stripe
# ============================================================================
# Use LIVE keys.
#
# Configure the webhook endpoint:
# https://shopsophisticat.com/api/orders/webhook/stripe/
#
# Copy the webhook signing secret below.

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


# ============================================================================
# Paystack
# ============================================================================
# Use LIVE keys from the Paystack Dashboard.

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=


# ============================================================================
# Flutterwave
# ============================================================================
# Currently disabled in the application.
# Leave blank unless the integration is re-enabled.

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=